# Turnos odontología (Cattaneo) — ejemplo de overrides para `docker compose`.
# Versionado: valores FICTICIOS, sin secretos reales (reglas duras 10 y 12).
#
# Uso:  Copy-Item .env.docker.example .env.docker
#       docker compose up -d --build
#
# El compose carga `.env` y, si existe, `.env.docker` (gana este último).
# `docker-compose.yml` exige Compose >= 2.24 (`env_file` con `required`).

# En la red del compose el host de la DB es el servicio `db`, no `localhost`.
# DEBE usar exactamente la misma password que POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://turnos:changeme-ejemplo-docker@db:5432/turnos
# La consume únicamente el servicio `db` (initdb del volumen pgdata).
POSTGRES_PASSWORD=changeme-ejemplo-docker
# La SPA se sirve same-origin: este origen es solo el allowlist de CORS.
FRONTEND_URL=http://localhost:8000
# Demo/local: el scheduler corre igual dentro de `web` (single instance).
NOTIF_WORKER_ENABLED=false
# Con un proxy inverso terminando TLS, bind loopback en lugar de 0.0.0.0.
# WEB_PORT=127.0.0.1:8000
