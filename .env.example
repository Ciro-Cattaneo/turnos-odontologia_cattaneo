# Turnos odontología (Cattaneo) — ejemplo versionado (KB-08).
# Valores FICTICIOS de ejemplo: nunca credenciales reales (regla dura 10 y 12).
# Copiar a `.env` (ignorado por git) y completar antes de `docker compose up`.
DATABASE_URL=postgresql+psycopg://turnos:changeme-ejemplo@db:5432/turnos
SECRET_KEY=changeme-ejemplo-64-hex-solo-local
ADMIN_EMAIL=admin-ejemplo@ficticio.test
ADMIN_PASSWORD=changeme-ejemplo-solo-local
SMTP_HOST=smtp.ejemplo.test
SMTP_PORT=587
SMTP_USER=usuario-ejemplo@ficticio.test
SMTP_PASS=changeme-ejemplo-solo-local
SMTP_FROM=turnos@ficticio.test
TZ=America/Argentina/Buenos_Aires
CANCEL_HOURS_MIN=3
SLOT_DEFAULT_MIN=30
FRONTEND_URL=http://localhost:5173
# REDIS_URL opcional — solo si el worker migra a ARQ/Celery (PB-03, no en v1).
# REDIS_URL=redis://redis:6379/0
