# Turnos odontología (Cattaneo) — ejemplo versionado (KB-08).
# Valores FICTICIOS de ejemplo: nunca credenciales reales (regla dura 10 y 12).
# Copiar a `.env` (ignorado por git) y completar antes de `docker compose up`.
#
# ENV: development | staging | prod (default development).
#   - prod: se rechazan placeholders (`changeme-*`, `*-ejemplo`) y un
#     SECRET_KEY de menos de 32 caracteres; el arranque falla y nombra
#     TODAS las variables faltantes/inválidas sin imprimir sus valores.
#   - development/staging: toleran placeholders locales (tests, demos).
ENV=development
DATABASE_URL=postgresql+psycopg://turnos:changeme-ejemplo@db:5432/turnos
# Solo para el servicio `db` del compose (el host interno es `db`).
POSTGRES_PASSWORD=changeme-ejemplo-solo-local
SECRET_KEY=changeme-ejemplo-64-hex-solo-local
ADMIN_EMAIL=admin-ejemplo@ficticio.test
ADMIN_PASSWORD=changeme-ejemplo-solo-local
# SMTP PROVISORIO/MIGRABLE: app password de un proveedor simple en v1;
# la ruta de reemplazo es un proveedor transaccional (ver docs/deploy-single-host.md).
SMTP_HOST=smtp.ejemplo.test
SMTP_PORT=587
SMTP_USER=usuario-ejemplo@ficticio.test
SMTP_PASS=changeme-ejemplo-solo-local
SMTP_FROM=turnos@ficticio.test
# TZ solo para presentación/logs: la persistencia de timestamps es UTC (D-5).
TZ=America/Argentina/Buenos_Aires
CANCEL_HOURS_MIN=3
SLOT_DEFAULT_MIN=30
# Opcional (no secreta): contacto mostrado cuando la cancelación queda fuera
# de plazo (C-06 D-11). Cambiarla por el canal real en deploy.
CONSULTORIO_CONTACTO=Comunicate con el consultorio para coordinar la cancelación
# Origen único habilitado para CORS (allowlist, nunca `*` con credenciales).
# En producción same-origin (SPA servida por la misma app) es inerte.
FRONTEND_URL=http://localhost:5173
SMTP_TIMEOUT_S=15
NOTIF_WORKER_ENABLED=true
NOTIF_WORKER_INTERVAL_MIN=5
NOTIF_WORKER_BATCH_SIZE=20
# Puerto publicado por el compose (default 8000). Con un proxy inverso en el
# host conviene bind loopback: WEB_PORT=127.0.0.1:8000 (TLS lo termina el
# proxy o el PaaS, nunca la app — D-7).
# WEB_PORT=127.0.0.1:8000
# REDIS_URL opcional — el worker v1 (APScheduler en-proceso) NO la usa;
# solo se documenta para una futura migración a ARQ/Celery (PB-03, no en v1).
# REDIS_URL=redis://redis:6379/0
